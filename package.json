{
  "name": "theque",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:extension && next build",
    "build:extension": "tsc -p extension/tsconfig.json",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:e2e": "tsx e2e/tap-targets.spec.ts",
    "seed": "tsx scripts/seed.ts",
    "backfill:images": "tsx --conditions=react-server scripts/backfill-image-cache.ts",
    "backfill:crew": "tsx --conditions=react-server scripts/backfill-tmdb-crew.ts",
    "backfill:item-text": "tsx --conditions=react-server scripts/backfill-item-text.ts",
    "eval:recommend": "tsx --conditions=react-server --env-file=.env.local scripts/eval-recommend.ts",
    "backfill:field-encryption": "tsx --conditions=react-server scripts/backfill-field-encryption.ts",
    "drive:create-folder": "tsx --conditions=react-server scripts/create-drive-folder.ts",
    "book:attach": "tsx --conditions=react-server scripts/attach-book-file.ts",
    "screenshots:extension-store": "node scripts/generate-extension-store-screenshots.mjs",
    "supabase:sync-auth": "node scripts/update-supabase-auth.mjs",
    "qa:install-browsers": "playwright install chromium",
    "qa:session-url": "node scripts/qa-local-session-url.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^2.3.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.198",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.10.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "next-view-transitions": "^0.3.5",
    "parse5": "^7.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.0.306",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.0.0",
    "playwright": "^1.60.0",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
