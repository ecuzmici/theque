# Supabase project: theque (ref: jucaqjkgyhyzixzaisjr)
NEXT_PUBLIC_SUPABASE_URL=https://jucaqjkgyhyzixzaisjr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — bot protection on the email sign-in code request.
# Public Site key (the matching Secret key goes in Supabase → Auth → CAPTCHA).
# When unset, the login page skips the CAPTCHA widget (so local dev works before
# the widget is provisioned) — keep it unset until CAPTCHA is enabled in Supabase.
# See docs/login-redesign-runbook.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — from Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Field-level encryption (ADR 0013) for items.note / items.verdict.
# Base64 encoding of 32 random bytes — generate with: openssl rand -base64 32
# WARNING: losing this key means losing all note/verdict contents forever —
# there is no recovery path. Never rotate or delete it as a "fix"; back it up
# alongside your Supabase credentials. Set in Vercel BEFORE deploying any code
# that reads/writes it, and never commit the real value.
FIELD_ENCRYPTION_KEY=

# Random secret for cron enrichment route
CRON_SECRET=

# Optional: Upstash Redis for durable rate limiting (B1).
# When unset, rate limiting is a no-op (safe for local dev).
# UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Vercel AI Gateway — powers AI recommendations (Workstream F).
# On Vercel deployments, auth is automatic via OIDC (VERCEL_OIDC_TOKEN) — no key needed.
# For local dev, create a key at Vercel dashboard → AI Gateway → API Keys:
AI_GATEWAY_API_KEY=
# Optional recommendation model fallback override (comma-separated, in priority order):
# RECOMMEND_MODELS=openai/gpt-5-nano,google/gemini-2.5-flash-lite,anthropic/claude-haiku-4.5

# Gemini API key — powers ALL LLM enrichment (background category enrichment
# and the "Enrich with AI" button) via the direct Gemini SDK.
# Create at https://aistudio.google.com/apikey (free tier covers single-user volume).
GEMINI_API_KEY=
LLM_ENRICHMENT_ENABLED=false
# GEMINI_ENRICHMENT_MODEL=gemini-2.5-flash-lite   # primary; falls back to gemini-2.5-flash
# ENRICHMENT_TIMEOUT_MS=15000

# Phase 2 enrichment fallbacks (both opt-in, default off).
# Jina Reader renders JS / bypasses many bot walls but sends the saved URL to a
# third party (r.jina.ai). Grounding uses Gemini Google Search for non-identifiable
# items (restaurants, travel); free tier ~1,500 grounded queries/day.
JINA_READER_ENABLED=false
LLM_GROUNDING_ENABLED=false
# JINA_READER_TIMEOUT_MS=8000
# GROUNDING_TIMEOUT_MS=15000
# GROUNDING_MODEL=gemini-2.5-flash-lite

# Optional — AI Recommendations (Workstream F)
# F1 Books recommendations — requires the AI Gateway above (no additional key needed)
# F2 Watch recommendations — additionally requires TMDB_API_KEY
# TMDB_API_KEY=                               # https://www.themoviedb.org/settings/api
#   Powers F2 watch recommendations AND the movies/TV enrichment resolver.
#   Other enrichment resolvers (Google Books, iTunes, YouTube oEmbed, GitHub) need no key.
# RECOMMEND_TEMPERATURE=0.5                   # default (lower = steadier picks)
# RECOMMEND_TIMEOUT_MS=20000                  # default (per model attempt)
# RECOMMEND_MIN_ITEMS=3                       # min shelf items before button is enabled
# RECOMMEND_MAX_INPUT_ITEMS=20                # max items sent to LLM for context
# RECOMMEND_COUNT=5                           # cards to return (requests 8, keeps 5)
# RECOMMEND_CACHE_TTL_SEC=86400               # result cache TTL (24h default)
# RECOMMEND_RATE_LIMIT_PER_DAY=20             # daily cap per user
# RECOMMEND_WATCH_REGION=US                   # streaming-availability fallback region (geo header wins)
# GOOGLE_BOOKS_API_KEY=                       # optional; raises the Google Books quota for book card descriptions

# Optional — raise the daily AI cap for specific trusted accounts.
# Elevation raises a cap, never removes it: every account keeps a backstop so a
# looping client or a stolen session can't burn the gateway key without bound.
# Listed ids get the higher of AI_LIMIT_ELEVATED_PER_DAY and the normal cap.
# AI_LIMIT_ELEVATED_USER_IDS=                 # comma-separated auth.users ids
# AI_LIMIT_ELEVATED_PER_DAY=200               # daily cap for those ids

# Optional — local QA session bootstrap (development only)
QA_DEV_SESSION_SECRET=
QA_DEV_EMAIL=

# Optional — local only: UUID from Supabase auth.users when running npm run seed
SEED_USER_ID=

# Optional — Management API token (Dashboard → Account → Access Tokens) for npm run supabase:sync-auth
# SUPABASE_ACCESS_TOKEN=

# Weekly digest (optional). The cron route /api/jobs/digest renders the
# "five things you saved and forgot" email; it only sends when both are set.
# RESEND_API_KEY=
# DIGEST_EMAIL_TO=
# DIGEST_EMAIL_FROM="theque <digest@theque.app>"

# Signing key for the weekly email's one-tap star links (/rate/<token>).
# The link IS the credential — it writes a 1-5 star rating with no login — so it
# is HMAC-signed over {item_id, user_id, stars, exp} and expires after 30 days.
# Generate with: openssl rand -base64 32
# When unset, minting throws and /rate/* refuses every link (fail closed); a
# link is never accepted unsigned. Rotating it invalidates links already in
# people's inboxes, which is the intended kill switch.
# RATING_LINK_SECRET=
