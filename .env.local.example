# Supabase project: theque (ref: jucaqjkgyhyzixzaisjr)
NEXT_PUBLIC_SUPABASE_URL=https://jucaqjkgyhyzixzaisjr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — bot protection on the email sign-in code request.
# Public Site key (the matching Secret key goes in Supabase → Auth → CAPTCHA).
# When unset, the login page skips the CAPTCHA widget (so local dev works before
# the widget is provisioned) — keep it unset until CAPTCHA is enabled in Supabase.
# See docs/login-redesign-runbook.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — from Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Field-level encryption (ADR 0013) for items.note / items.verdict.
# Base64 encoding of 32 random bytes — generate with: openssl rand -base64 32
# WARNING: losing this key means losing all note/verdict contents forever —
# there is no recovery path. Never rotate or delete it as a "fix"; back it up
# alongside your Supabase credentials. Set in Vercel BEFORE deploying any code
# that reads/writes it, and never commit the real value.
FIELD_ENCRYPTION_KEY=

# Random secret for cron enrichment route
CRON_SECRET=

# Optional: Upstash Redis for durable rate limiting (B1).
# When unset, rate limiting is a no-op (safe for local dev).
# UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Vercel AI Gateway — powers AI recommendations (Workstream F) and LLM enrichment
# (background category enrichment and the "Enrich with AI" button).
# On Vercel deployments, auth is automatic via OIDC (VERCEL_OIDC_TOKEN) — no key needed.
# For local dev, create a key at Vercel dashboard → AI Gateway → API Keys:
AI_GATEWAY_API_KEY=
# Optional recommendation model fallback override (comma-separated, in priority order):
# RECOMMEND_MODELS=google/gemini-3.6-flash,openai/gpt-6-luna,google/gemini-3.5-flash-lite

# LLM enrichment runs through the AI Gateway (ADR 0017). It needs gateway auth above.
LLM_ENRICHMENT_ENABLED=false
# Optional enrichment model fallback override (comma-separated, in priority order):
# ENRICHMENT_MODELS=openai/gpt-6-luna,anthropic/claude-haiku-5.5
# ENRICHMENT_TIMEOUT_MS=15000   # per model attempt

# Gemini API key — used only for grounded search (LLM_GROUNDING_ENABLED below).
# Create at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Phase 2 enrichment fallbacks (both opt-in, default off).
# Jina Reader renders JS / bypasses many bot walls but sends the saved URL to a
# third party (r.jina.ai). Grounding uses Gemini Google Search for non-identifiable
# items (restaurants, travel); free tier ~1,500 grounded queries/day.
JINA_READER_ENABLED=false
LLM_GROUNDING_ENABLED=false
# JINA_READER_TIMEOUT_MS=8000
# GROUNDING_TIMEOUT_MS=15000
# GROUNDING_MODEL=gemini-3.5-flash-lite

# Optional — AI Recommendations (Workstream F)
# F1 Books recommendations — requires the AI Gateway above (no additional key needed)
# F2 Watch recommendations — additionally requires TMDB_API_KEY
# TMDB_API_KEY=                               # https://www.themoviedb.org/settings/api
#   Powers F2 watch recommendations AND the movies/TV enrichment resolver.
#   Other enrichment resolvers (Google Books, iTunes, YouTube oEmbed, GitHub) need no key.
# RECOMMEND_TEMPERATURE=0.5                   # default (lower = steadier picks)
# RECOMMEND_TIMEOUT_MS=20000                  # default (per model attempt)
# RECOMMEND_MIN_ITEMS=3                       # min shelf items before button is enabled
# RECOMMEND_MAX_INPUT_ITEMS=20                # max items sent to LLM for context
# RECOMMEND_COUNT=5                           # cards to return (requests 8, keeps 5)
# RECOMMEND_CACHE_TTL_SEC=86400               # result cache TTL (24h default)
# RECOMMEND_RATE_LIMIT_PER_DAY=20             # daily cap per user
# RECOMMEND_WATCH_REGION=US                   # streaming-availability fallback region (geo header wins)
# GOOGLE_BOOKS_API_KEY=                       # optional; raises the Google Books quota for book card descriptions

# Optional — raise the daily AI cap for specific trusted accounts.
# Elevation raises a cap, never removes it: every account keeps a backstop so a
# looping client or a stolen session can't burn the gateway key without bound.
# Listed ids get the higher of AI_LIMIT_ELEVATED_PER_DAY and the normal cap.
# AI_LIMIT_ELEVATED_USER_IDS=                 # comma-separated auth.users ids
# AI_LIMIT_ELEVATED_PER_DAY=200               # daily cap for those ids

# Optional — local QA session bootstrap (development only)
QA_DEV_SESSION_SECRET=
QA_DEV_EMAIL=

# Optional — local only: UUID from Supabase auth.users when running npm run seed
SEED_USER_ID=

# Optional — Management API token (Dashboard → Account → Access Tokens) for npm run supabase:sync-auth
# SUPABASE_ACCESS_TOKEN=

# Weekly digest (optional). The cron route /api/jobs/digest renders the
# "five things you saved and forgot" email; it only sends when both are set.
# RESEND_API_KEY=
# DIGEST_EMAIL_TO=
# DIGEST_EMAIL_FROM="theque <digest@theque.app>"

# Hardcover book metadata (optional, server-only).
# Personal API token from https://hardcover.app account settings.
# Enrichment falls back to Google Books when this is absent.
# The token expires after one year and resets on January 1.
HARDCOVER_API_KEY=

# Google Drive EPUB sync (optional, server-only).
# theque uploads EPUB files to one Drive folder; a Kobo reader syncs that folder.
# Use an OAuth client for a normal Google account, NOT a service account: a
# service account has no Drive storage quota and owns the files as the wrong user.
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
# with the https://www.googleapis.com/auth/drive.file scope, then get a refresh
# token once with the OAuth playground. Sync stays off until all four are set.
# Keep the scope at drive.file. The wider .../auth/drive scope is restricted, so
# Google holds the app in a branding review that needs a live homepage, a terms
# of service URL and a privacy policy URL. drive.file publishes at once.
# Publish the OAuth consent screen to production. In Testing mode Google expires
# the refresh token after 7 days, and sync then stops.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Do NOT copy this id from a Drive folder URL. The drive.file scope shows the app
# only the folders that the app made, so an upload to a hand-made folder gets a
# 404. Run `npm run drive:create-folder` once. It makes the folder, shares it
# with anybody who holds the link, and prints the id for the line below.
GOOGLE_DRIVE_FOLDER_ID=
# The private folder for Kindle users (KOReader reads it through /opds).
# Run `npm run drive:create-folder -- --private "Kindle"` once to make it.
# When this is empty, a Kindle upload fails with drive_not_configured. It never
# goes to the public Kobo folder. See docs/kindle-opds.md.
GOOGLE_DRIVE_KINDLE_FOLDER_ID=

# --- Access and cost limits (review remediation, 2026-10) ---
# Book files (the "Kobo file" block): comma-separated user ids that can upload
# and remove book files. Unset or empty uses the code default in
# src/lib/book-file-access.ts. A set value replaces the default list.
BOOK_FILE_USER_IDS=
# Comma-separated user ids that get the Kindle target: a plain EPUB in
# GOOGLE_DRIVE_KINDLE_FOLDER_ID, with no KEPUB step. All other users get the
# Kobo target. Unset or empty uses the code default in book-file-access.ts.
BOOK_FILE_KINDLE_USER_IDS=
# The manual digest job (/api/jobs/digest) reads the items of this user id
# only. Without it, the job answers 503.
DIGEST_USER_ID=
# Daily caps per user. Default 100 background LLM enrichments and 30
# "Enrich with AI" proposals. AI_LIMIT_ELEVATED_USER_IDS can raise both.
ENRICH_LLM_DAILY_LIMIT=
AI_PROPOSAL_DAILY_LIMIT=
