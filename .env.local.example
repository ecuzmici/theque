# Supabase project: theque (ref: jucaqjkgyhyzixzaisjr)
NEXT_PUBLIC_SUPABASE_URL=https://jucaqjkgyhyzixzaisjr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — from Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Random secret for cron enrichment route
CRON_SECRET=

# Optional: Upstash Redis for durable rate limiting (B1).
# When unset, rate limiting is a no-op (safe for local dev).
# UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional server-only Gemini category normalization
GEMINI_API_KEY=
LLM_ENRICHMENT_ENABLED=false
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=10000

# Optional — AI Recommendations (Workstream F)
# F1 Books recommendations — requires GEMINI_API_KEY above (no additional key needed)
# F2 Watch recommendations — additionally requires TMDB_API_KEY
# TMDB_API_KEY=                               # from https://www.themoviedb.org/settings/api
# GEMINI_RECOMMEND_MODEL=gemini-2.5-flash     # default
# GEMINI_RECOMMEND_TEMPERATURE=0.7            # default
# GEMINI_RECOMMEND_TIMEOUT_MS=20000           # default
# RECOMMEND_MIN_ITEMS=3                       # min shelf items before button is enabled
# RECOMMEND_MAX_INPUT_ITEMS=20                # max items sent to LLM for context
# RECOMMEND_COUNT=5                           # cards to return (requests 8, keeps 5)
# RECOMMEND_CACHE_TTL_SEC=86400               # result cache TTL (24h default)
# RECOMMEND_RATE_LIMIT_PER_DAY=20             # daily cap per user

# Optional — local QA session bootstrap (development only)
QA_DEV_SESSION_SECRET=
QA_DEV_EMAIL=

# Optional — local only: UUID from Supabase auth.users when running npm run seed
SEED_USER_ID=

# Optional — Management API token (Dashboard → Account → Access Tokens) for npm run supabase:sync-auth
# SUPABASE_ACCESS_TOKEN=
