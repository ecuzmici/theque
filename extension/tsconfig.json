{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": false,
    "outDir": ".",
    "rootDir": ".",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": ["*.ts"],
  "exclude": ["*.js", "*.test.ts"]
}
