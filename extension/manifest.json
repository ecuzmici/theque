{
  "manifest_version": 3,
  "name": "thèque",
  "short_name": "thèque",
  "version": "1.0.0",
  "description": "Save the current tab to your thèque library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to thèque"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://theque.app/*", "https://theque.vercel.app/*"],
  "externally_connectable": {
    "matches": ["https://theque.app/*", "https://theque.vercel.app/*"]
  },
  "background": {
    "service_worker": "background.js"
  }
}
