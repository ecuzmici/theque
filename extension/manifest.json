{
  "manifest_version": 3,
  "name": "Theque Capture",
  "short_name": "Theque",
  "version": "0.1.0",
  "description": "Save the current tab to your Theque library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Theque"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
