{
  "manifest_version": 3,
  "name": "Keepswell Capture",
  "short_name": "Keepswell",
  "version": "0.1.0",
  "description": "Save the current tab to your Keepswell library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Keepswell"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  }
}
