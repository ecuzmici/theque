{
  "manifest_version": 3,
  "name": "thèque capture",
  "short_name": "thèque",
  "version": "0.1.0",
  "description": "Save the current tab to your thèque library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to thèque"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://theque.app/*"],
  "externally_connectable": {
    "matches": ["https://theque.app/*"]
  },
  "background": {
    "service_worker": "background.js"
  }
}
